# ==============================================================================
# BASE DE DATOS POSTGRESQL (SUPABASE / PRISMA)
# ==============================================================================
# Conexión Transaction Pooler (puerto 6543) para el runtime en Next.js
DATABASE_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:6543/postgres?pgbouncer=true&connection_limit=1"

# Conexión directa (puerto 5432) requerida para migraciones con 'npx prisma migrate'
DIRECT_URL="postgresql://postgres.[PROJECT-REF]:[PASSWORD]@aws-0-[REGION].pooler.supabase.com:5432/postgres"

# ==============================================================================
# SUPABASE AUTH, DATABASE & STORAGE
# ==============================================================================
NEXT_PUBLIC_SUPABASE_URL="https://[PROJECT-REF].supabase.co"
NEXT_PUBLIC_SUPABASE_ANON_KEY="eyJhbGciOi..."
SUPABASE_SERVICE_ROLE_KEY="eyJhbGciOi..."

# URL base del sitio (para redirects OAuth en dev o producción)
NEXT_PUBLIC_SITE_URL="http://localhost:3000"

# ==============================================================================
# ADMINISTRADOR DEL SISTEMA
# ==============================================================================
ADMIN_EMAIL="admin@tudominio.com"
NEXT_PUBLIC_ADMIN_EMAIL="admin@tudominio.com"
ADMIN_PASSWORD="TuContraseñaSegura123*"

# ==============================================================================
# SECRETOS PARA FIRMA JWT (ACCESS TOKEN & REFRESH TOKEN)
# ==============================================================================
JWT_ACCESS_SECRET="clave-secreta-para-access-token-jwt-min-32-chars"
JWT_REFRESH_SECRET="clave-secreta-para-refresh-token-jwt-min-32-chars"
