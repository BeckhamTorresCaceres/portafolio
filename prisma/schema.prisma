// Prisma schema for Portafolio

generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Profile {
  id          String   @id @default(uuid())
  name        String
  role        String
  headline    String?
  description String?
  bio         String
  avatarUrl   String?
  email       String
  githubUrl   String?
  linkedinUrl String?
  twitterUrl  String?
  cvUrl       String?
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model Project {
  id          String         @id @default(uuid())
  title       String
  slug        String         @unique
  description String
  content     String?
  stack       String[]
  coverImage  String?
  demoUrl     String?
  repoUrl     String?
  order       Int            @default(0)
  published   Boolean        @default(true)
  createdAt   DateTime       @default(now())
  updatedAt   DateTime       @updatedAt
  images      ProjectImage[]
  comments    Comment[]
}

model ProjectImage {
  id        String   @id @default(uuid())
  projectId String
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  url       String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Skill {
  id        String   @id @default(uuid())
  name      String
  category  String
  order     Int      @default(0)
  createdAt DateTime @default(now())
}

model Experience {
  id          String   @id @default(uuid())
  period      String
  role        String
  company     String
  description String
  order       Int      @default(0)
  createdAt   DateTime @default(now())
}

model Admin {
  id        String   @id @default(uuid())
  userId    String   @unique
  email     String?
  createdAt DateTime @default(now())
}

model Comment {
  id         String   @id @default(uuid())
  userId     String
  userName   String
  userAvatar String?
  projectId  String?
  project    Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content    String
  status     String   @default("visible") // "visible" | "hidden"
  createdAt  DateTime @default(now())
  updatedAt  DateTime @updatedAt
}
